{
  "uid": "fraud-writer",
  "title": "02 PostgreSQL writes",
  "schemaVersion": 40,
  "version": 1,
  "tags": [
    "fraud",
    "seminar-11"
  ],
  "timezone": "browser",
  "editable": false,
  "refresh": "2s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "1s",
      "2s",
      "5s",
      "10s",
      "30s"
    ]
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "New committed scores per second",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "fraud-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(fraud_writer_rows_total[30s]))",
          "datasource": {
            "type": "prometheus",
            "uid": "fraud-prom"
          },
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "Database commit latency p95",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "fraud-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(fraud_writer_commit_seconds_bucket[30s])))",
          "datasource": {
            "type": "prometheus",
            "uid": "fraud-prom"
          },
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "Fraud rows committed since writer start",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "fraud-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "fraud_writer_fraud_total",
          "datasource": {
            "type": "prometheus",
            "uid": "fraud-prom"
          },
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "Committed score distribution over time",
      "description": "",
      "type": "heatmap",
      "datasource": {
        "type": "prometheus",
        "uid": "fraud-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (le) (rate(fraud_writer_score_bucket{le!=\"+Inf\"}[30s]))",
          "datasource": {
            "type": "prometheus",
            "uid": "fraud-prom"
          },
          "range": true,
          "instant": false,
          "format": "heatmap"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "calculate": false,
        "cellGap": 1,
        "color": {
          "mode": "scheme",
          "scheme": "Oranges"
        },
        "yAxis": {
          "unit": "short",
          "min": 0,
          "max": 1
        },
        "legend": {
          "show": true
        },
        "tooltip": {
          "show": true,
          "yHistogram": false
        }
      }
    },
    {
      "id": 5,
      "title": "Stored scores and fraud share by model",
      "description": "Live PostgreSQL aggregate for the selected time range, independent of process restarts.",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fraud-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fraud-pg"
          },
          "rawSql": "SELECT model_version, count(*) AS scores, avg(fraud_flag)::double precision AS fraud_share\nFROM transaction_scores WHERE $__timeFilter(processed_at)\nGROUP BY model_version ORDER BY scores DESC",
          "rawQuery": true,
          "format": "table",
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "fraud_share"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 6,
      "title": "Duplicate deliveries skipped",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "fraud-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "fraud_writer_duplicates_total",
          "datasource": {
            "type": "prometheus",
            "uid": "fraud-prom"
          },
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "title": "Writer errors per second",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "fraud-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(fraud_writer_errors_total[30s]))",
          "datasource": {
            "type": "prometheus",
            "uid": "fraud-prom"
          },
          "range": true,
          "instant": false,
          "format": "time_series",
          "legendFormat": "{{reason}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ]
}
