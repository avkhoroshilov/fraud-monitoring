{
  "uid": "fraud-scoring",
  "title": "01 Scoring and model updates",
  "schemaVersion": 40,
  "version": 1,
  "tags": [
    "fraud",
    "seminar-11"
  ],
  "timezone": "browser",
  "editable": false,
  "refresh": "2s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "1s",
      "2s",
      "5s",
      "10s",
      "30s"
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Model hot reload",
        "enable": true,
        "hide": false,
        "iconColor": "rgba(163, 82, 204, 1)",
        "datasource": {
          "type": "prometheus",
          "uid": "fraud-prom"
        },
        "expr": "fraud_model_reload_timestamp_seconds > (time() - 30)",
        "step": "1s",
        "tagKeys": "version",
        "titleFormat": "Model {{version}}",
        "textFormat": "Scorer loaded model {{version}} without restarting"
      }
    ]
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Scored transactions per second",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "fraud-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(fraud_scoring_transactions_total[30s]))",
          "datasource": {
            "type": "prometheus",
            "uid": "fraud-prom"
          },
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "Processing latency p95",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "fraud-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(fraud_scoring_processing_seconds_bucket[30s])))",
          "datasource": {
            "type": "prometheus",
            "uid": "fraud-prom"
          },
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "Fraud share over 30 seconds",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "fraud-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(fraud_scoring_fraud_total[30s])) / clamp_min(sum(rate(fraud_scoring_transactions_total[30s])), 0.000001)",
          "datasource": {
            "type": "prometheus",
            "uid": "fraud-prom"
          },
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "Score distribution over time",
      "description": "",
      "type": "heatmap",
      "datasource": {
        "type": "prometheus",
        "uid": "fraud-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (le) (rate(fraud_scoring_score_bucket{le!=\"+Inf\"}[30s]))",
          "datasource": {
            "type": "prometheus",
            "uid": "fraud-prom"
          },
          "range": true,
          "instant": false,
          "format": "heatmap"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "calculate": false,
        "cellGap": 1,
        "color": {
          "mode": "scheme",
          "scheme": "Oranges"
        },
        "yAxis": {
          "unit": "short",
          "min": 0,
          "max": 1
        },
        "legend": {
          "show": true
        },
        "tooltip": {
          "show": true,
          "yHistogram": false
        }
      }
    },
    {
      "id": 5,
      "title": "Seconds since last scored event",
      "description": "Extra metric absent from the seminar: detects a stalled stream even while /metrics responds. Zero timestamp means no event yet.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "fraud-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - fraud_scoring_last_success_timestamp_seconds",
          "datasource": {
            "type": "prometheus",
            "uid": "fraud-prom"
          },
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "Hot loads by model version",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "fraud-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "fraud_model_updates_total",
          "datasource": {
            "type": "prometheus",
            "uid": "fraud-prom"
          },
          "range": true,
          "instant": false,
          "format": "time_series",
          "legendFormat": "{{version}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "title": "Scoring errors by reason",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "fraud-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(fraud_scoring_errors_total[30s]))",
          "datasource": {
            "type": "prometheus",
            "uid": "fraud-prom"
          },
          "range": true,
          "instant": false,
          "format": "time_series",
          "legendFormat": "{{reason}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "title": "Failed model reload attempts",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "fraud-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "fraud_model_reload_errors_total",
          "datasource": {
            "type": "prometheus",
            "uid": "fraud-prom"
          },
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ]
}
