{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "fraud-stream",
      "folder": "Fraud Monitoring",
      "interval": "10s",
      "rules": [
        {
          "uid": "fraud-high-share",
          "title": "Fraud share above 40 percent",
          "condition": "B",
          "for": "30s",
          "noDataState": "Alerting",
          "execErrState": "Alerting",
          "isPaused": false,
          "annotations": {
            "summary": "Predicted fraud share > 40% for 30 seconds",
            "__dashboardUid__": "fraud-scoring",
            "__panelId__": "3"
          },
          "labels": {
            "severity": "warning",
            "service": "fraud"
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "fraud-prom",
              "relativeTimeRange": {
                "from": 60,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "(sum(rate(fraud_scoring_fraud_total[30s])) / clamp_min(sum(rate(fraud_scoring_transactions_total[30s])), 0.000001)) or vector(0)",
                "instant": true,
                "range": false,
                "datasource": {
                  "type": "prometheus",
                  "uid": "fraud-prom"
                },
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0.4
                      ]
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "B"
                      ]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    },
                    "type": "query"
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "fraud-stopped-stream",
          "title": "Scoring stream stopped",
          "condition": "B",
          "for": "30s",
          "noDataState": "Alerting",
          "execErrState": "Alerting",
          "isPaused": false,
          "annotations": {
            "summary": "Acknowledged scoring TPS < 0.01 for 30 seconds",
            "__dashboardUid__": "fraud-scoring",
            "__panelId__": "1"
          },
          "labels": {
            "severity": "warning",
            "service": "fraud"
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "fraud-prom",
              "relativeTimeRange": {
                "from": 60,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "sum(rate(fraud_scoring_transactions_total[30s])) or vector(0)",
                "instant": true,
                "range": false,
                "datasource": {
                  "type": "prometheus",
                  "uid": "fraud-prom"
                },
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "conditions": [
                  {
                    "evaluator": {
                      "type": "lt",
                      "params": [
                        0.01
                      ]
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "B"
                      ]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    },
                    "type": "query"
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
